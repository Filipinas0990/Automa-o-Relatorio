# ─────────────────────────────────────────────────────────────────────────────
# PharmaFlow — variáveis de ambiente
# Copie para .env e preencha os valores reais
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados
DATABASE_URL=postgresql://farmacia:farmacia123@localhost:5432/farmacia_monitor

# JWT
JWT_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ADMIN_SECRET=segredo-para-criar-o-super-admin

# Servidor
PORT=8000
LOG_LEVEL=info

# Frontend (usado no redirect após OAuth do Google)
FRONTEND_URL=https://pharmarelatorios.online

# ─────────────────────────────────────────────────────────────────────────────
# Google Calendar — Integração OAuth2
# Como configurar:
#   1. Acesse https://console.cloud.google.com/
#   2. Crie um projeto (ou use um existente)
#   3. Ative a "Google Calendar API" em "APIs e Serviços"
#   4. Em "Credenciais" → "Criar credenciais" → "ID do cliente OAuth 2.0"
#   5. Tipo: "Aplicativo da Web"
#   6. URI de redirecionamento autorizado: ${GOOGLE_REDIRECT_URI} abaixo
#   7. Copie Client ID e Client Secret aqui
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-SEU_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.pharmarelatorios.online/api/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# Evolution API — WhatsApp (notificação de confirmação 5h antes das reuniões)
# Como configurar:
#   1. Acesse sua instância da Evolution API
#   2. Crie ou use uma instância existente já conectada ao WhatsApp
#   3. Copie a URL base, a API Key global e o nome da instância abaixo
# ─────────────────────────────────────────────────────────────────────────────
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua-api-key-aqui

# Segredo opcional para proteger o endpoint POST /api/whatsapp/webhook
# Configure o mesmo valor no painel da Evolution API em "Webhook Secret"
EVOLUTION_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI — GPT-4o para interpretação de mensagens dos gestores
# Como configurar:
#   1. Acesse https://platform.openai.com/api-keys
#   2. Crie uma chave de API
#   3. Cole abaixo
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────────────────────────────────────
# Meta Marketing API — criação de campanhas
# Como configurar por cliente:
#   1. Crie um App no Meta for Developers (tipo Business)
#   2. Adicione a permissão "ads_management" ao App
#   3. Gere um User Access Token (longa duração) para cada cliente
#   4. Cadastre via POST /api/ads/tokens (rota admin)
# ─────────────────────────────────────────────────────────────────────────────
# (tokens armazenados no banco, tabela meta_tokens — não precisa de env aqui)
